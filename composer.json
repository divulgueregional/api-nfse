{
    "name": "divulgueregional/api-nfse",
    "description": "Api para gerar nota fiscal de serviço no ambiente nacional.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "nfse",
        "nota fiscal",
        "sefin",
        "adn",
        "nfs-e nacional"
    ],
    "autoload": {
        "psr-4": {
            "Divulgueregional\\ApiNfse\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Roseno Matos",
            "email": "rosenomatos@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "ext-curl": "Recomendado para as conexões mTLS com o Ambiente Nacional",
        "dompdf/dompdf": "Necessário para gerar o PDF do DANFSe em examples/danfse"
    },
    "scripts": {
        "test": "php tests/run-tests.php"
    },
    "config": {
        "sort-packages": true
    }
}
